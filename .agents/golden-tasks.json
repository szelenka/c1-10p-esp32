{
  "composition_rule": "Multi-template tasks: union reads + verification. Use the most restrictive done_when.",
  "no_match": "No template fits? Follow CLAUDE.md Constraints + Task Routing. Golden tasks are shortcuts, not requirements.",
  "default_verification": ["make test", "make format"],
  "default_verification_note": "Matches the shared minimum verification. If an actuator path is reachable, also run make check-safety.",
  "default_reads": [],
  "field_notes": {
    "keywords_and_triggers": "Both 'keywords' and 'triggers' are used for task matching. Treat them as a single pool of match terms — keywords are broader synonyms, triggers are specific phrases.",
    "parallel_units": "Tasks with 'parallel_units' may be split across agents only with orchestrator mode. Each unit must have declared ownership and disjoint file sets. See orchestrator.md §Multi-Agent."
  },
  "index": [
    "Add a new button mapping",
    "Add an existing-pattern node",
    "Safety-path change",
    "Fix a failing test",
    "Add a new telemetry field",
    "Telemetry UI parser update",
    "Docs-only cleanup",
    "Add a new hardware peripheral",
    "Refactor without behavior change",
    "Add a new message type",
    "Investigate unknown root cause",
    "Edit agent instructions"
  ],
  "tasks": [
    {
      "name": "Add a new button mapping",
      "classification": "single_subsystem",
      "blast_radius": "medium",
      "single_agent_default": true,
      "parallelizable": false,
      "persona_order": ["implementer"],
      "keywords": ["button", "remap", "mapping", "controller", "press", "joycon"],
      "triggers": ["button mapping", "remap button", "button press", "controller mapping"],
      "must_read": [".agents/extended.md"],
      "reads": [".agents/extended.md"],
      "reads_optional": [".agents/policies/placement-reasoning.md"],
      "touch_set": ["main/include/chopper/input/DriveIntentMapping.h", "test/test_control_mapping.cpp", "docs/reference/behaviors.md"],
      "verification": ["make lint-embedded", "make check-safety-paths"],
      "manual_checks": ["Trace downstream consumers to decide whether actuator reachability makes this safety-critical."],
      "stop_conditions": ["If mapping now reaches an actuator path, load safety-auditor guidance before editing further."],
      "done_when": ["Mapping in intent table, NOT action node.", "If actuator reachable: safety reviewed.", "behaviors.md updated.", "Test covers intent path."],
      "common_mistake": "Editing DriveNode.h for button remapping instead of DriveIntentMapping.h"
    },
    {
      "name": "Add an existing-pattern node",
      "classification": "single_subsystem",
      "blast_radius": "high",
      "single_agent_default": true,
      "parallelizable": false,
      "persona_order": ["implementer", "tester", "docs"],
      "keywords": ["node", "create", "new", "add", "publish", "subscribe"],
      "triggers": ["new node", "add node", "create node"],
      "must_read": [".agents/extended.md"],
      "reads": [".agents/extended.md"],
      "reads_optional": ["docs/reference/node-template.md"],
      "touch_set": ["main/include/chopper/nodes/<Name>Node.h", "test/test_<name>.cpp", "Makefile", "docs/registry.md"],
      "verification": ["make lint-embedded", "make check-docs", "make check-test-inventory"],
      "manual_checks": ["Confirm placement in the pipeline before creating a new node rather than extending an existing one."],
      "stop_conditions": ["If the node changes capacity or message budgets, load architect guidance first."],
      "done_when": ["PublishingNode pattern followed.", "Test + DEPS_ entry exist.", "registry.md updated."]
    },
    {
      "name": "Safety-path change",
      "classification": "safety_critical",
      "blast_radius": "blocking",
      "single_agent_default": true,
      "parallelizable": false,
      "persona_order": ["safety-auditor", "implementer", "tester"],
      "keywords": ["safety", "motor", "servo", "actuator", "bridge", "degradation", "emergency", "stop"],
      "triggers": ["safety", "motor", "servo", "actuator", "bridge node", "degradation", "emergency stop"],
      "must_read": [".agents/extended.md"],
      "reads": [".agents/extended.md"],
      "reads_optional": [".agents/extended.md"],
      "touch_set": ["main/include/chopper/safety/", "main/include/chopper/nodes/MotorBridgeNode.h", "main/include/chopper/nodes/ServoBridgeNode.h", "test/test_safety.cpp"],
      "verification": ["make check-safety", "make check-safety-ordering", "make check-safety-paths"],
      "manual_checks": ["Trace the full command path from source topic to bridge and hardware registration."],
      "stop_conditions": ["Any bypass of DegradationManager or SafetyManager is BLOCKING.", "Any missing EmergencyStopChain registration is BLOCKING."],
      "done_when": ["Commands gated by degradation mode.", "Regression test exists.", "No BLOCKING findings.", "safety-auditor.md Invariants still hold."]
    },
    {
      "name": "Fix a failing test",
      "classification": "single_subsystem",
      "blast_radius": "medium",
      "single_agent_default": true,
      "parallelizable": false,
      "persona_order": ["tester", "implementer"],
      "keywords": ["test", "fix", "fail", "broken", "assertion", "check", "require"],
      "triggers": ["fix test", "test failure", "failing test", "broken test"],
      "must_read": [".agents/extended.md"],
      "reads": [".agents/extended.md"],
      "touch_set": ["test/test_<name>.cpp", "main/include/chopper/<area>/<Name>.h"],
      "verification": ["make lint-embedded"],
      "manual_checks": ["Decide whether the bug is in the test, the production code, or stale known_failures state."],
      "stop_conditions": ["If the easiest path is weakening an assertion, stop and fix the underlying behavior instead."],
      "done_when": ["Root cause: test bug vs code bug.", "Fix on correct side.", "No assertions weakened (see CLAUDE.md Hard Rules #2).", "All tests pass."],
      "common_mistake": "Weakening the assertion to make the test pass instead of fixing the code"
    },
    {
